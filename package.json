{
  "name": "@agenthooksprotocol/adapter-opencode",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Hooks Protocol adapter for OpenCode, as an OpenCode plugin",
  "license": "Apache-2.0",
  "repository": "github:agenthooksprotocol/adapter-opencode",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": ">=1.19.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/unit",
    "test:e2e": "npm run build && bun test --timeout 60000 test/e2e",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "agenthooksprotocol": "0.11.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@types/bun": "1.3.5",
    "opencode-ai": "1.19.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
